#
# Make Unix users and [<user>] shares match /etc/ow/users.json, then reload smbd.
# Usage: ow-sync [--no-reload]
set -eu

USERS_JSON=/etc/ow/users.json
SHARES=/etc/samba/ow-shares.conf
UID_MIN=2000
UID_MAX=2999

[ -f "$USERS_JSON" ] || { echo "no $USERS_JSON yet" >&2; : > "$SHARES"; exit 0; }

valid_name() { echo "$1" | grep -Eq '^[a-z][a-z0-9]{1,30}$'; }

tmp=$(mktemp)
wanted=$(mktemp)
trap 'rm -f "$tmp" "$wanted"' EXIT

jq -r '.users[] | "\(.name) \(.uid)"' "$USERS_JSON" | while read -r name uid; do
    valid_name "$name" || { echo "skipping invalid name: $name" >&2; continue; }
    case "$uid" in ''|*[!0-9]*) echo "skipping $name: bad uid" >&2; continue ;; esac
    echo "$name" >> "$wanted"
    if ! getent group "$name" >/dev/null; then addgroup -g "$uid" "$name"; fi
    if ! getent passwd "$name" >/dev/null; then
        adduser -D -H -h "/srv/users/$name" -s /sbin/nologin -u "$uid" -G "$name" "$name"
    fi
    cat >> "$tmp" <<SHARE
[$name]
   path = /srv/users/$name
   valid users = $name
   read only = no
   browseable = yes
   create mask = 0640
   directory mask = 0750

SHARE
done

# Remove Unix users (in our UID range) that are no longer in users.json.
getent passwd | awk -F: -v lo="$UID_MIN" -v hi="$UID_MAX" '$3 >= lo && $3 <= hi {print $1}' |
while read -r name; do
    if ! grep -qx "$name" "$wanted"; then
        pdbedit -x -u "$name" >/dev/null 2>&1 || true
        deluser "$name" 2>/dev/null || true
        delgroup "$name" 2>/dev/null || true
    fi
done

mv "$tmp" "$SHARES"
chmod 644 "$SHARES"
if [ "${1:-}" != "--no-reload" ]; then
    smbcontrol smbd reload-config >/dev/null 2>&1 || true
fi
