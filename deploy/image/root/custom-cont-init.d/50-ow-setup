# Runs as root at every desktop start (LinuxServer custom-init hook).

# Home folders are private to their owner.
chmod 750 /config

# Group/project folders: OW_GROUPS="labx:3001 proj:3002". Create each group with its fixed GID
# and add abc, so desktop apps can write to /groups/<name> (s6 keeps supplementary groups).
for entry in ${OW_GROUPS:-}; do
    name=${entry%%:*}
    gid=${entry##*:}
    case "$name" in *[!a-z0-9]*|'') continue ;; esac
    case "$gid" in *[!0-9]*|'') continue ;; esac
    getent group "$name" >/dev/null || groupadd -g "$gid" "$name"
    usermod -aG "$name" abc
done

# GPU device nodes (/dev/dri, and /dev/kfd on AMD) belong to the host's video and render groups,
# whose GIDs the image may not know. Add abc to each owning group, creating a group for an
# unknown GID. Webtop desktops do this themselves; terminal-only images don't (ADR 0037).
for dev in /dev/dri/* /dev/kfd; do
    [ -c "$dev" ] || continue
    gid=$(stat -c %g "$dev")
    [ "$gid" = 0 ] && continue
    group=$(getent group "$gid" | cut -d: -f1)
    if [ -z "$group" ]; then
        group="ow-gpu$gid"
        groupadd -g "$gid" "$group"
    fi
    usermod -aG "$group" abc
done

# Launcher icons (desktops only): every ow-*.desktop that add-ons installed goes on the Desktop;
# icons of add-ons that are no longer installed are removed. Other files are left alone.
if [ "${OW_GUI:-true}" != "false" ]; then
    desktop=/config/Desktop
    mkdir -p "$desktop"
    chown abc:abc "$desktop"
    for src in /usr/share/applications/ow-*.desktop; do
        [ -e "$src" ] || continue
        dst="$desktop/$(basename "$src")"
        install -o abc -g abc -m 755 "$src" "$dst"
    done
    for icon in "$desktop"/ow-*.desktop; do
        [ -e "$icon" ] || continue
        [ -e "/usr/share/applications/$(basename "$icon")" ] || rm -f -- "$icon"
    done
fi

# User environment variables (OrbitalWindow's environment page, ADR 0032): the container has
# them, but sshd doesn't pass its environment on, so login shells read them from a profile script.
profile=/etc/profile.d/ow-user-env.sh
: > "$profile"
for name in ${OW_USER_ENV:-}; do
    case "$name" in [A-Za-z_]*) ;; *) continue ;; esac
    case "$name" in *[!A-Za-z0-9_]*) continue ;; esac
    [ -n "${!name+set}" ] || continue
    printf 'export %s=%q\n' "$name" "${!name}" >> "$profile"
done
chmod 644 "$profile"
# END user environment variables

# Terminal-only containers report healthy from here on (Dockerfile.terminal's HEALTHCHECK).
touch /run/ow-ready
