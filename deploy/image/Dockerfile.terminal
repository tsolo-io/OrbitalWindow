# OrbitalWindow terminal-only image (no desktop), built by the service as ow-terminal:<name>
# from a LinuxServer base image of any distribution ow-pkg supports (ADR 0033, ADR 0034). The
# base gives s6, the abc user from PUID/PGID and /config as home, so add-ons, SSH and the
# browser terminal work as in a desktop.
ARG BASE_IMAGE=lscr.io/linuxserver/baseimage-ubuntu:noble
FROM ${BASE_IMAGE}

COPY root/usr/local/bin/ow-pkg /usr/local/bin/ow-pkg
COPY base-packages.sh /tmp/base-packages.sh
# The host's GPU vendor (the GPU setting): Intel images get the compute runtime.
ARG GPU_VENDOR=none
RUN sh /tmp/base-packages.sh terminal "$GPU_VENDOR" && rm /tmp/base-packages.sh

COPY root/ /

# Ready once OrbitalWindow's start-up script has run (it is the last init step that matters).
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --start-interval=2s \
  CMD test -e /run/ow-ready || exit 1
