#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# SPDX-FileCopyrightText: 2026 Tsolo.io
#
# SPDX-License-Identifier: Apache-2.0
#
# Replaces LinuxServer's service: no password (Traefik's forwardAuth lets only the owner in, and
# only Traefik shares the container's network), settings in ~/.local/share/code-server, and the
# home (/home) opened as the workspace.

data=/home/.local/share/code-server
exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z 127.0.0.1 8443" \
        s6-setuidgid abc \
            /app/code-server/bin/code-server \
                --bind-addr 0.0.0.0:8443 \
                --user-data-dir "$data" \
                --extensions-dir "$data/extensions" \
                --disable-telemetry \
                --disable-update-check \
                --auth none \
                --app-name "VS Code" \
                /home
