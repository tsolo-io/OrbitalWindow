# Copy to deploy/.env and `chmod 600 deploy/.env`.

# Image version for the production compose file (a release tag such as v1.0.0, or main).
OW_VERSION=main
# Host folder for homes, groups, shared software and state (DuckDB, secret key). Back it up.
OW_ROOT=/srv/orbitalwindow
# Name (or IP) users type in the browser and in Windows Explorer.
OW_HOSTNAME=desk.example.org
TZ=Africa/Johannesburg
# nvidia, amd, intel or none (no GPU passed to desktops).
OW_GPU_VENDOR=nvidia
# Desktop built on first start (LinuxServer webtop tag).
OW_DEFAULT_DESKTOP=ubuntu-xfce
# Real TLS certificate (Let's Encrypt, DNS-01) for OW_HOSTNAME. Leave empty to keep Traefik's
# self-signed certificate. The provider is a Traefik/lego provider code (for example cloudflare,
# route53, digitalocean, hetzner). Its credentials go in deploy/acme.env (chmod 600), e.g.
#   OW_ACME_DNS_PROVIDER=cloudflare        (here)
#   CF_DNS_API_TOKEN=...                   (in deploy/acme.env)
OW_ACME_DNS_PROVIDER=
OW_ACME_EMAIL=
# Traefik access log (one JSON line per request in `docker logs ow-traefik`: time, client,
# path, status, duration; no headers or cookies). Useful for troubleshooting connections.
OW_TRAEFIK_ACCESS_LOG=false
# llmfit image for the model suggestions on the AI page (llmfit releases often; newer tags at
# https://github.com/AlexsJones/llmfit/pkgs/container/llmfit).
OW_LLMFIT_IMAGE=ghcr.io/alexsjones/llmfit:1.1.15
# vLLM image for the AI session (https://hub.docker.com/r/vllm/vllm-openai/tags). About 30 GB.
OW_VLLM_IMAGE=vllm/vllm-openai:v0.30.0
# vLLM image for Intel GPUs (https://hub.docker.com/r/vllm/vllm-openai-xpu/tags). About 17 GB.
OW_VLLM_INTEL_IMAGE=vllm/vllm-openai-xpu:v0.30.0
# Open WebUI image for the AI chat (https://github.com/open-webui/open-webui/pkgs/container/open-webui).
OW_OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.4
# AI engine on first start: vllm or llamacpp (later in Settings -> AI). vLLM does not work on
# Intel GPUs; use llamacpp there.
OW_AI_ENGINE=vllm
# llama.cpp build (https://github.com/ggml-org/llama.cpp/releases). The image follows the GPU:
# ghcr.io/ggml-org/llama.cpp:server-<cuda|intel|rocm>-<build>. The Intel one is about 16 GB.
OW_LLAMACPP_BUILD=b11382
# code-server image that VS Code in the browser is built on
# (https://github.com/linuxserver/docker-code-server/pkgs/container/code-server).
OW_CODE_SERVER_IMAGE=lscr.io/linuxserver/code-server:4.140.0-ls368
# Compose files for a plain `docker compose up -d` in this folder (the Makefile works out its own
# list and ignores this). Separate with ':'. Add compose.nvidia.yaml on NVIDIA servers or
# compose.intel.yaml on Intel servers, so the admin pages show GPU numbers, and compose.tls.yaml
# when OW_ACME_DNS_PROVIDER is set.
COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
# Password for the first admin (user "admin"), used only when there are no users yet.
CONTROL_ADMIN_PASSWORD=
